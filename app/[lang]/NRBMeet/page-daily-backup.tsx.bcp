"use client"

import { useEffect, useRef, useState } from 'react'

// Replace with your actual Daily.co API key
const DAILY_API_KEY = process.env.NEXT_PUBLIC_DAILY_API_KEY || 'YOUR_DAILY_API_KEY'

export default function VideoTestPage() {
  const [roomUrl, setRoomUrl] = useState<string>('')
  const [isCreatingRoom, setIsCreatingRoom] = useState(false)
  const [callState, setCallState] = useState<'idle' | 'joining' | 'joined' | 'left'>('idle')
  const [error, setError] = useState<string>('')
  const videoRef = useRef<HTMLDivElement>(null)
  const callFrameRef = useRef<any>(null)

  // Load Daily.co script dynamically
  useEffect(() => {
    const script = document.createElement('script')
    script.src = 'https://unpkg.com/@daily-co/daily-js'
    script.async = true
    script.onload = () => {
      console.log('Daily.co script loaded')
    }
    document.head.appendChild(script)

    return () => {
      // Clean up if component unmounts
      if (callFrameRef.current) {
        callFrameRef.current.leave()
      }
    }
  }, [])

  // Create a new video room
const createRoom = async () => {
  setIsCreatingRoom(true)
  setError('')

  try {
    // Use your backend proxy instead
    const response = await fetch('/api/daily/create-room', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
    })

    const data = await response.json()

    if (!response.ok) {
      throw new Error(data.error || 'Failed to create room')
    }

    setRoomUrl(data.url)
    console.log('Room created:', data.url)
  } catch (err: any) {
    setError(`Failed to create room: ${err.message}`)
    console.error('Error creating room:', err)
  } finally {
    setIsCreatingRoom(false)
  }
}

  // Join the video call
  const joinCall = () => {
    if (!roomUrl || !(window as any).DailyIframe) {
      setError('Room URL not available or Daily.co not loaded')
      return
    }

    setCallState('joining')

    // Create the call frame
    callFrameRef.current = (window as any).DailyIframe.createFrame(
      videoRef.current,
      {
        iframeStyle: {
          position: 'relative',
          width: '100%',
          height: '500px',
          border: '1px solid #e2e8f0',
          borderRadius: '8px',
        },
        showLeaveButton: true,
        showFullscreenButton: true,
      }
    )

    // Set up event listeners
    callFrameRef.current
      .on('joined-meeting', () => {
        setCallState('joined')
        console.log('Joined the meeting')
      })
      .on('left-meeting', () => {
        setCallState('left')
        console.log('Left the meeting')
      })
      .on('error', (err: any) => {
        setError(`Call error: ${err.errorMsg}`)
        console.error('Call error:', err)
      })

    // Join the call
    callFrameRef.current.join({ url: roomUrl })
  }

  // Leave the video call
  const leaveCall = () => {
    if (callFrameRef.current) {
      callFrameRef.current.leave()
      setCallState('left')
    }
  }

  // Copy room URL to clipboard
  const copyRoomUrl = () => {
    navigator.clipboard.writeText(roomUrl)
    alert('Room URL copied to clipboard! Share it with others to join.')
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 p-6">
      <div className="max-w-4xl mx-auto">
        {/* Header */}
        <div className="mb-8 text-center">
          <h1 className="text-3xl font-bold text-slate-900 mb-2">
            Daily.co Video Call Test
          </h1>
          <p className="text-slate-600">
            Test video calls for your freelancing platform
          </p>
        </div>

        {/* Error Display */}
        {error && (
          <div className="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
            <p className="text-red-700 font-medium">Error:</p>
            <p className="text-red-600">{error}</p>
          </div>
        )}

        <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
          {/* Left Column: Controls */}
          <div className="space-y-6">
            <div className="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
              <h2 className="text-xl font-semibold text-slate-900 mb-4">
                Room Controls
              </h2>

              {/* Create Room Button */}
              <button
                onClick={createRoom}
                disabled={isCreatingRoom || !!roomUrl}
                className={`w-full py-3 px-4 rounded-lg font-medium mb-4 ${
                  isCreatingRoom || roomUrl
                    ? 'bg-blue-100 text-blue-400 cursor-not-allowed'
                    : 'bg-blue-600 hover:bg-blue-700 text-white'
                }`}
              >
                {isCreatingRoom ? (
                  <span className="flex items-center justify-center">
                    <svg className="animate-spin h-5 w-5 mr-3 text-white" viewBox="0 0 24 24">
                      <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" />
                      <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                    </svg>
                    Creating Room...
                  </span>
                ) : (
                  'Create New Video Room'
                )}
              </button>

              {/* Room URL Display */}
              {roomUrl && (
                <div className="mb-4">
                  <label className="block text-sm font-medium text-slate-700 mb-2">
                    Room URL
                  </label>
                  <div className="flex gap-2">
                    <input
                      type="text"
                      value={roomUrl}
                      readOnly
                      className="flex-1 px-3 py-2 border border-slate-300 rounded-lg bg-slate-50 text-slate-600 text-sm"
                    />
                    <button
                      onClick={copyRoomUrl}
                      className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-medium"
                    >
                      Copy
                    </button>
                  </div>
                </div>
              )}

              {/* Call Controls */}
              <div className="space-y-3">
                <button
                  onClick={joinCall}
                  disabled={!roomUrl || callState === 'joined' || callState === 'joining'}
                  className={`w-full py-3 px-4 rounded-lg font-medium ${
                    !roomUrl || callState === 'joined' || callState === 'joining'
                      ? 'bg-green-100 text-green-400 cursor-not-allowed'
                      : 'bg-green-600 hover:bg-green-700 text-white'
                  }`}
                >
                  {callState === 'joining' ? 'Joining...' : 'Join Video Call'}
                </button>

                <button
                  onClick={leaveCall}
                  disabled={callState !== 'joined'}
                  className={`w-full py-3 px-4 rounded-lg font-medium ${
                    callState !== 'joined'
                      ? 'bg-red-100 text-red-300 cursor-not-allowed'
                      : 'bg-red-600 hover:bg-red-700 text-white'
                  }`}
                >
                  Leave Call
                </button>
              </div>
            </div>

            {/* Instructions */}
            <div className="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
              <h2 className="text-xl font-semibold text-slate-900 mb-4">
                How to Test
              </h2>
              <ol className="list-decimal pl-5 space-y-2 text-slate-600">
                <li>Click "Create New Video Room"</li>
                <li>Copy the Room URL and share it with another person</li>
                <li>Click "Join Video Call"</li>
                <li>Allow camera/microphone permissions when prompted</li>
                <li>Test the video and audio quality</li>
                <li>Use "Leave Call" to exit</li>
              </ol>
            </div>
          </div>

          {/* Right Column: Video Display */}
          <div className="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
            <h2 className="text-xl font-semibold text-slate-900 mb-4">
              Video Preview
            </h2>

            {/* Video Container */}
            <div
              ref={videoRef}
              className="bg-slate-900 rounded-lg overflow-hidden min-h-[500px] flex items-center justify-center"
            >
              {callState === 'idle' && (
                <div className="text-center p-8">
                  <div className="text-slate-400 mb-4">
                    <svg className="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <p className="text-slate-400">
                    Create a room and join to start the video call
                  </p>
                </div>
              )}
              {callState === 'left' && (
                <div className="text-center p-8">
                  <div className="text-green-500 mb-4">
                    <svg className="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <p className="text-slate-700 font-medium">
                    Call ended successfully
                  </p>
                  <p className="text-slate-500 text-sm mt-2">
                    Click "Join Video Call" to reconnect
                  </p>
                </div>
              )}
            </div>

            {/* Call Status */}
            <div className="mt-4 p-3 bg-slate-50 rounded-lg">
              <div className="flex items-center justify-between">
                <span className="text-slate-700 font-medium">Status:</span>
                <span className={`px-3 py-1 rounded-full text-sm font-medium ${
                  callState === 'idle' ? 'bg-blue-100 text-blue-800' :
                  callState === 'joining' ? 'bg-yellow-100 text-yellow-800' :
                  callState === 'joined' ? 'bg-green-100 text-green-800' :
                  'bg-slate-100 text-slate-800'
                }`}>
                  {callState === 'idle' && 'Ready to start'}
                  {callState === 'joining' && 'Joining call...'}
                  {callState === 'joined' && 'In call'}
                  {callState === 'left' && 'Call ended'}
                </span>
              </div>
            </div>
          </div>
        </div>

        {/* API Key Info */}
        <div className="mt-8 p-4 bg-slate-50 rounded-lg text-center">
          <p className="text-sm text-slate-500">
            Using API Key: <code className="bg-slate-200 px-2 py-1 rounded text-xs">
              {DAILY_API_KEY.substring(0, 8)}...{DAILY_API_KEY.substring(DAILY_API_KEY.length - 4)}
            </code>
          </p>
          <p className="text-xs text-slate-400 mt-2">
            Keep your API key secure. Do not expose it in production.
          </p>
        </div>
      </div>
    </div>
  )
}